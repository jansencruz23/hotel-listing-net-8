<ul class="navbar-nav">
    @if (User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            <p class="nav-link">Hello @User.Identity.Name! @* @(User.Claims.FirstOrDefault(q => q.Type == "iddd")) *@</p>
            
        </li>
        <li class="nav-item">
            <form class="form-inline" method="post" asp-action="Logout" asp-controller="User">
                <button type="submit" class="nav-link btn btn-link">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-action="Register" asp-controller="User">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-action="Login" asp-controller="User">Login</a>
        </li>
    }
</ul>