# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono auto generated)
mono_crash.*

# User-specific files (Visual Studio Code)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.{json,code-workspace}

# Ignore folder for Visual Studio Code Workspace file
.vscode/

# User-specific files (JetBrains Rider)
.idea/

# Auto generated files (Visual Studio Code)
*.localhistory

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code directories
.vscode/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# =========================
# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# NPM Packages
node_modules/

# ===============
# Yarn
.yarn
.pnp.*
.pnp

# ===============
# Custom exclusions
.vs
.idea
.localhistory
.vscode

# Dependency directories
node_modules/

# Coverage directory used by tools like istanbul
coverage/

# VS Code directories
.vscode/

# Rider directories
.idea/
.idea_modules/

# System binary files
*.dll
*.exe

# Webpack
dist/

# Miscellaneous files
.DS_Store
.vs/
.env

# Logs
logs
*.log

# NPM debug log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Output directories
bin/
obj/

# Coverage results
*.lcov

# Exclude build outputs
!bin/Release/
!bin/Debug/
